# Container naming
CONTAINER_NAME=classic-mac-vnc

# Which classic Mac OS to boot: 7 (System 7.5.5, via Basilisk II — 68k),
# 8 (Mac OS 8, via Basilisk II — 68k), or 9 (Mac OS 9, via SheepShaver —
# PowerPC; interpreter-only on arm64/Apple Silicon hosts, no JIT
# acceleration there — see README). Each version keeps its own separate
# ROM/disk state under data/macos<version>/, so switching this later
# doesn't affect the others.
MAC_OS_VERSION=8

# Host port to connect a VNC client to.
VNC_PORT=5900

# Strongly recommended — VNC has no built-in transport encryption, and an
# unauthenticated VNC server is reachable by anyone who can reach
# VNC_PORT. Leave empty only if you've bound VNC_PORT to localhost only,
# or otherwise trust everything that can reach this host.
VNC_PASSWORD=

# Emulated screen resolution — the emulator's own window is sized to
# exactly fill this, so your VNC client's view matches it 1:1.
SCREEN_WIDTH=800
SCREEN_HEIGHT=600
