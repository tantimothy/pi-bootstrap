# Hermes Agent — a personal agent platform with a learning loop. It writes
# its own skills from successful runs, keeps persistent memory, speaks ~20
# chat platforms through one gateway, and runs cron jobs and subagents.
#
# ⚠️  THE VALUE OF THIS ENVIRONMENT IS ENTIRELY ACCUMULATED STATE. The image
# is stateless and replaceable; HERMES_DATA_PATH is not. Back it up from day
# one, not after the first loss — info.yaml declares it so `backup.sh`
# already covers it.

CONTAINER_NAME=hermes

# Host directory mounted at /opt/data — the single source of truth for ALL
# Hermes state: .env (API keys), config.yaml, SOUL.md (the agent's
# personality), sessions/, memories/, skills/, cron/, hooks/, logs/, and the
# per-profile home/ that git/ssh/gh/npm and skill CLIs use.
HERMES_DATA_PATH=~/.hermes

# Match these to the owner of HERMES_DATA_PATH. The image's s6-overlay hook
# remaps its internal hermes user to these values and then drops to it, so a
# mismatch means the agent cannot write its own memories or skills — and that
# surfaces as Hermes behaving oddly, not as a mount error.
# Raspberry Pi OS commonly uses 1000/1000; macOS commonly uses 501/20.
PUID=1000
PGID=1000

# --- Image ---

# Upstream tags :latest and :main on every push to main, plus :<release-tag>
# on a release. PIN A RELEASE TAG. check-updates.sh compares running image
# IDs, so :latest reports an available update every time main moves —
# several times a week — which trains you to ignore it.
# Format: a release tag, or "latest".
#HERMES_IMAGE_TAG=latest

# --- Networking ---

# Host address the published ports bind to. The dashboard binds 0.0.0.0
# INSIDE the container (it has to, or a published port would be
# unreachable), so THIS is what actually decides who can reach it.
#
# Leave it at loopback and reach the dashboard over an SSH tunnel:
#   ssh -L 9119:localhost:9119 <host>
# Format: an IP address.
#HERMES_BIND_ADDRESS=127.0.0.1

#HERMES_DASHBOARD_PORT=9119
#API_SERVER_PORT=8642

# --- Dashboard ---
#
# ⚠️  The dashboard drives a real agent: it can read every credential in the
# data directory and run commands. Upstream REMOVED its own --insecure flag
# after an unauthenticated public dashboard was the entry point for the June
# 2026 MCP-config persistence campaign — internet scanners reached exposed
# dashboards and drove the agent into planting an SSH-key backdoor.
#
# pre-deploy.sh refuses to deploy with the dashboard on and no auth provider
# configured. That is deliberate: Hermes itself fails closed, but it does so
# inside the container, as a dashboard that silently never comes up.
#
# Format: 1 to enable the supervised dashboard service.
#HERMES_DASHBOARD=1

# Provider 1 of 3: username/password. The zero-infrastructure option for a
# trusted LAN or a VPN. Upstream: "not suitable for direct public-internet
# exposure."
#HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
#HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=

# Keeps dashboard sessions valid across a container restart. Without it,
# every restart logs you out. Generate with: openssl rand -hex 32
#HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# Provider 2 of 3: OAuth via Nous Portal — upstream's recommendation for
# anything internet-facing. Provision with `hermes dashboard register`.
#HERMES_DASHBOARD_OAUTH_CLIENT_ID=

# Provider 3 of 3: your own identity provider over standard OIDC.
#HERMES_DASHBOARD_OIDC_ISSUER=
#HERMES_DASHBOARD_OIDC_CLIENT_ID=

# --- OpenAI-compatible API server ---
#
# Off unless enabled. Only needed if something outside the container should
# talk to the gateway as if it were OpenAI — this repo's chat-frontends, for
# instance. Chat platforms (Telegram, Discord, Slack…) do not need it.
#API_SERVER_ENABLED=true

# To listen beyond the container's own loopback, set this to 0.0.0.0 AND set
# a key. The key is mandatory, minimum 8 characters:
#   openssl rand -hex 32
#API_SERVER_HOST=0.0.0.0
#API_SERVER_KEY=

# --- Chat platform tokens ---
#
# NOT set here. Hermes keeps its own .env inside HERMES_DATA_PATH, written by
# its interactive setup wizard, and that is where platform tokens belong —
# duplicating them into this file would give you two places to rotate a
# token and one of them silently stale.
#
# First run, after deploying once:
#
#   docker run -it --rm -v ~/.hermes:/opt/data \
#     nousresearch/hermes-agent setup
#
# Then edit ~/.hermes/.env directly, or use the dashboard.
