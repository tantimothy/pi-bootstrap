# Container / image naming
CONTAINER_NAME=sheepshaver
DOCKER_IMAGE_TAG=pi-bootstrap-sheepshaver

# X11 display to forward — :0 is the standard local Pi/Linux desktop
# display. If connecting over SSH with X forwarding, set this to $DISPLAY
# from that session instead.
DISPLAY=:0
HOST_X11_UNIX_PATH=/tmp/.X11-unix

# Host audio device passed through to the container (skipped automatically
# if it doesn't exist)
HOST_SOUND_DEVICE=/dev/snd

# PulseAudio socket to forward for sound inside the emulated Mac. Default
# assumes the current user's own PulseAudio; override for a system-wide
# PulseAudio/PipeWire-pulse socket instead.
HOST_PULSE_NATIVE_SOCKET=/run/user/1000/pulse/native

# Where your ROM, hard disk image and SheepShaver config live on the host
# (bind-mounted to /data in the container). Point this at an existing
# directory if you already have a SheepShaver setup elsewhere.
SS_DATA_PATH=./data

# Host directory shared with the emulated Mac as an extra drive (SheepShaver
# can be finicky about filenames — keep this to a single flat directory)
SS_EXTFS=./shared

# Paths *inside* the container (under /data) to your ROM and hard disk file
SS_ROM=/data/sheepshaver.rom
SS_DISK=/data/disk

# RAM allocated to the emulated Mac, in bytes (default 256 MB)
SS_RAM=268435456

# Emulated display resolution
SS_WIDTH=1024
SS_HEIGHT=768

# Networking: "slirp" (default, no host device needed) or "ether" (bridged,
# requires the sheep_net NetDriver kernel module built on the host — see
# README.md)
SS_NET=slirp

# Hide the SheepShaver GUI at launch and boot straight from the command-line
# settings above (recommended once your ROM/disk are configured — leaving
# the GUI on is known to sometimes render a black screen)
SS_NO_GUI=false

# Use SheepShaver's JIT compiler (much faster; disable only to troubleshoot)
SS_JIT=true
