# Standalone Pi coding-agent container reachable over SSH. Each interactive
# login attaches to a persistent tmux session running Pi in the mounted
# workspace.
#
# ⚠️  Pi is YOLO by default — no permission prompts, no sandbox. Its author's
# position is that "security in coding agents is mostly theater; if it can
# write and run code, it's game over." That is a defensible argument, and it
# means the CONTAINER BOUNDARY and a PER-ENVIRONMENT SCOPED TOKEN are the
# only things doing that job in this image. Give this environment its own
# GH_TOKEN scoped to the repos you actually mount — not a token shared with
# another environment.
#
# And note what the container does NOT cover, because it protects the host
# rather than what is inside reach: your mounted repository, these very
# credentials, and whatever host.docker.internal reaches. Third-party
# extensions (pi-sandbox, pi-secrets, pi-guard) address that layer and none
# is installed here. See README's "What YOLO by default costs you".

CONTAINER_NAME=pi
SSH_PORT=2227

# Host directory mounted at /home/pi/workspace.
PI_WORKSPACE_PATH=~/pi-workspace

# Public keys allowed to log in. One standard authorized_keys entry per line.
SSH_AUTHORIZED_KEYS_PATH=~/.ssh/authorized_keys

# Match these to the owner of PI_WORKSPACE_PATH on the TARGET host.
# Raspberry Pi OS commonly uses 1000/1000. macOS commonly uses 501/20;
# confirm on the Mac that will actually run the environment with `id -u`
# and `id -g`. The entrypoint safely handles macOS GID 20 even though a
# Debian group with that numeric ID already exists inside the image.
PUID=1000
PGID=1000

# Optional Git identity.
#GIT_USER_NAME=Your Name
#GIT_USER_EMAIL=you@example.com

# Optional GitHub token for gh and HTTPS git operations. SSH agent forwarding
# is an alternative and does not require this setting.
#
# ⚠️  Scope it to this environment. Six coding CLIs working on different
# repos is the expected shape here; one token shared across all of them means
# any of them can push to any of the others' projects.
#GH_TOKEN=

# --- Version pinning ---

# ⚠️  THE SCOPE MATTERS AS MUCH AS THE VERSION. Four npm scopes publish a
# package called pi-coding-agent and all four install without error:
#
#   @earendil-works/pi-coding-agent   <- current canonical Pi (what we install)
#   @mariozechner/pi-coding-agent     <- pre-acquisition Pi, STILL PUBLISHED,
#                                        twelve minors behind, named by older
#                                        guides, installs cleanly, nothing
#                                        catches it
#   @oh-my-pi/pi-coding-agent         <- omp, a DIFFERENT PRODUCT (18.x)
#   @badlogic/pi
#
# The Dockerfile hardcodes the scope; this pins the version within it.
# Bumping it needs a CLEAN, not a FAST.
# Format: an exact npm version.
#PI_PACKAGE_VERSION=0.85.1

# mcporter — an MCP *client* runtime. Pi has no native MCP by design (a tool
# schema costs 7-14k tokens of context against Pi's ~200-token system
# prompt); mcporter puts MCP back within reach as a command the bash tool
# calls, which costs nothing until it is invoked.
# Format: an exact npm version, or "latest".
#MCPORTER_VERSION=latest

# --- Credentials ---
#
# ⚠️  PI DOES NOT READ A .env FILE. A provider key has to already be in the
# shell environment when `pi` launches, or that provider simply does not
# appear in /model and nothing says why. The entrypoint writes these into
# /etc/environment, which PAM loads into every SSH login — which is where
# the tmux session, and therefore Pi, is started.
#
# The alternative is Pi's own `/login`, which stores a subscription
# credential in ~/.pi/agent/auth.json inside the persistent volume. Leave
# these unset if you use that.
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#GEMINI_API_KEY=
#OPENROUTER_API_KEY=

# --- Model selection ---

# Passed to `pi --model` when the base tmux session starts. Pi accepts a
# pattern, an ID, or provider/id. Leave unset to use Pi's saved startup
# default (Ctrl+S in the /model picker saves one).
#PI_MODEL=

# Passed to `pi --thinking`. One of: off, minimal, low, medium, high, xhigh, max.
#PI_THINKING=

# --- Routing through this repo's llm-gateways ---
#
# ⚠️  DIFFERENT FROM aider AND claude-cli. Pi has NO base-URL environment
# variable — no OPENAI_API_BASE, no equivalent. A non-built-in provider is
# declared in ~/.pi/agent/models.json with a baseUrl, and that is the only
# route.
#
# Set these and the entrypoint writes that file for you — but ONLY IF IT DOES
# NOT ALREADY EXIST. It is a file you edit by hand (extra models, per-model
# overrides, compat flags), and a deploy that rewrote it every time would
# silently discard that work.
#
# host.docker.internal, not localhost and not a container name: pi and
# llm-gateways are separate Compose projects with no shared network, so the
# host is the only way through. Same reasoning as aider's README.
#PI_GATEWAY_BASE_URL=http://host.docker.internal:4000/v1

# llm-gateways' own LITELLM_MASTER_KEY. Pi treats a model as unavailable
# until auth is configured, so even a gateway that ignores the key needs a
# placeholder — the entrypoint uses "gateway" if you leave this unset.
#PI_GATEWAY_API_KEY=

# Comma-separated model_name entries from llm-gateways' litellm-config.yaml.
#PI_GATEWAY_MODELS=claude-sonnet-5,claude-opus-5,ollama/qwen2.5-coder:7b

# --- Network behaviour ---

# Pi contacts pi.dev at startup for a version check, and sends an anonymous
# version ping after an install or update.
# Format: 1 to disable ALL startup network operations (update checks, package
# update checks, telemetry).
#PI_OFFLINE=

# Format: 0 to disable install/update telemetry only (update checks continue).
#PI_TELEMETRY=

# Format: 1 to skip the version check only (telemetry unaffected).
#PI_SKIP_VERSION_CHECK=
