# Container naming
CONTAINER_NAME=infinite-mac

# Host port for the web UI (HTTPS, self-signed certificate — your browser
# will warn on first visit, same as Portainer's HTTPS port in this repo).
# Format: A valid local TCP port. Access via https://<pi-ip>:<port>
INFINITE_MAC_PORT=4127

# Upstream repository/ref to build from. Override INFINITE_MAC_REF to pin
# a specific tag/commit instead of always tracking the latest default
# branch. Changing either requires a rebuild to take effect (CLEAN, or the
# faster "Update to latest infinite-mac" custom action).
INFINITE_MAC_REPO=https://github.com/mihaip/infinite-mac.git
INFINITE_MAC_REF=main
