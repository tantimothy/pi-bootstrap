# Standalone Codex CLI container reachable over SSH. Each interactive login
# attaches to a persistent tmux session running Codex in the mounted workspace.

CONTAINER_NAME=codex-cli
SSH_PORT=2224

# Host directory mounted at /home/codex/workspace.
CODEX_WORKSPACE_PATH=~/codex-cli-workspace

# Public keys allowed to log in. One standard authorized_keys entry per line.
SSH_AUTHORIZED_KEYS_PATH=~/.ssh/authorized_keys

# Match these to the owner of CODEX_WORKSPACE_PATH on the TARGET host.
# Raspberry Pi OS commonly uses 1000/1000. macOS commonly uses 501/20;
# confirm on the Mac that will actually run the environment with `id -u`
# and `id -g`. The entrypoint safely handles macOS GID 20 even though a
# Debian group with that numeric ID already exists inside the image.
PUID=1000
PGID=1000

# Optional Git identity.
#GIT_USER_NAME=Your Name
#GIT_USER_EMAIL=you@example.com

# Optional GitHub token for gh and HTTPS git operations. SSH agent forwarding
# is an alternative and does not require this setting.
#GH_TOKEN=

# Optional non-interactive Codex authentication. Prefer leaving these unset
# and using `codex login --device-auth` on first connection. If supplied, the
# entrypoint imports the credential into Codex's persistent auth cache only
# when no valid login is already present.
#OPENAI_API_KEY=
#CODEX_ACCESS_TOKEN=

# Optional model passed to `codex --model` when the base tmux session starts.
# Leave unset to let Codex select its current default.
#CODEX_MODEL=
