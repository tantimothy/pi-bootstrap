#!/usr/bin/env bash
#
# install-bb — build AA-lib's BB demo into ~/bin/bb.d.
#
# BB is the one splash in whimsy-splash's catalogue that nothing packages
# for macOS: no Homebrew formula, no MacPorts port (both checked). Upstream
# is a 1997 autoconf-2.13 tarball on SourceForge; what's built here is
# github.com/artyfarty/bb-osx, a fork whose whole purpose is making that
# tree compile on a modern Mac. It ships a generated `configure`, so this
# needs no autotools of its own — just a compiler, aalib and libmikmod.
#
# Everything lands under ~/bin/bb.d (source in src/, binary in bin/) with
# --prefix, so nothing touches /usr/local and nothing needs sudo.
#
# Run by run.sh once, best-effort, when whimsy is enabled and bb isn't
# already present. Run it yourself any time to retry:
#
#   ~/bin/install-bb            # build if not already built
#   ~/bin/install-bb --force    # rebuild from scratch, ignoring a past failure
#
# A failed build writes .build-failed next to the log and is not retried
# automatically — a compiler error on a 28-year-old codebase is not
# something a fourth identical attempt at the next deploy will fix, and
# silently burning a minute of every `run.sh` on it would be worse than
# saying so once.

set -u

BB_DIR="$HOME/bin/bb.d"
BB_SRC="$BB_DIR/src"
BB_LOG="$BB_DIR/build.log"
BB_FAILED="$BB_DIR/.build-failed"
BB_REPO="https://github.com/artyfarty/bb-osx.git"

FORCE=false
[ "${1:-}" = "--force" ] && FORCE=true

if [ -x "$BB_DIR/bin/bb" ] && [ "$FORCE" = "false" ]; then
    echo "   ✅ bb already built ($BB_DIR/bin/bb)."
    exit 0
fi

if [ -f "$BB_FAILED" ] && [ "$FORCE" = "false" ]; then
    echo "   ⏭️  Skipping bb — a previous build failed. Details: $BB_LOG"
    echo "      Retry with: ~/bin/install-bb --force"
    exit 0
fi

# git and a compiler are the two things that can't be worked around here.
# On a Mac both arrive together with the Xcode Command Line Tools, so a
# machine missing one is generally missing both.
for tool in git make cc; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "   ⚠️  bb needs '$tool', which isn't installed." >&2
        echo "      On macOS: xcode-select --install" >&2
        exit 1
    fi
done

# aalib is what bb renders through; libmikmod is its music. Both are
# Homebrew formulas. aalib is already in packages-whimsy.txt (aafire needs
# it too); libmikmod is only ever needed to build bb, which is why it's
# installed here rather than in the always-installed list.
if command -v brew >/dev/null 2>&1; then
    for formula in aalib libmikmod; do
        brew list --formula "$formula" >/dev/null 2>&1 || {
            echo "   📦 Installing $formula (bb build dependency)..."
            brew install "$formula" || echo "   ⚠️  brew install $formula failed — continuing anyway." >&2
        }
    done
else
    echo "   ⚠️  Homebrew not found — bb needs aalib and libmikmod. Continuing anyway." >&2
fi

mkdir -p "$BB_DIR"
rm -f "$BB_FAILED"

echo "   🎬 Building bb from $BB_REPO..."
{
    echo "=== install-bb $(date) ==="
    if [ -d "$BB_SRC/.git" ]; then
        # Discard our own edits first. This script deletes one tracked file
        # (config.cache) and patches another (config.h) below, and
        # `git pull` refuses to touch a tree with local modifications the
        # moment upstream changes either of them — turning a routine
        # --force retry into a fetch failure for no reason. Both edits are
        # ours and are reapplied a few lines down, so there is nothing to
        # preserve.
        git -C "$BB_SRC" checkout -- .
        git -C "$BB_SRC" pull --ff-only
    else
        rm -rf "$BB_SRC"
        git clone --depth 1 "$BB_REPO" "$BB_SRC"
    fi
} > "$BB_LOG" 2>&1 || {
    echo "   ⚠️  Couldn't fetch the bb source — see $BB_LOG" >&2
    touch "$BB_FAILED"
    exit 1
}

# The fork commits its maintainer's own config.cache — confirmed directly:
# it hardcodes ac_cv_path_AALIB_CONFIG=/usr/local/bin/aalib-config and
# LIBMIKMOD_CONFIG=no. autoconf 2.13 loads that file before probing
# anything, so on an Apple Silicon Mac (Homebrew at /opt/homebrew, not
# /usr/local) configure would "find" an aalib-config that isn't there and
# fail with "AALIB >= 1.4.0 not installed" no matter how correctly aalib
# was installed. Deleted here and disabled with --cache-file=/dev/null, so
# every probe is answered by this machine rather than by someone else's
# from years ago.
rm -f "$BB_SRC/config.cache"

# git records no mtimes, so a fresh clone lands every generated autotools
# file with an essentially random ordering relative to its own source —
# and whenever aclocal.m4 comes out older than configure.in, make dutifully
# tries to regenerate the lot with whatever aclocal/automake this machine
# has. On a 1997 tree that fails outright (confirmed directly: "required
# file './compile' not found", from a modern automake refusing a
# two-argument AM_INIT_AUTOMAKE), and on a typical Mac it fails even
# sooner, because nobody has autotools installed at all.
#
# Touching them in dependency order — source first, then each thing
# derived from it — makes every generated file newer than its input, so
# those rules never fire. The AUTO* overrides passed to make below are the
# belt to this pair of braces.
for generated in configure.in aclocal.m4 configure aconfig.h.in stamp-h.in Makefile.in; do
    [ -f "$BB_SRC/$generated" ] && touch "$BB_SRC/$generated"
done

# bb declares its hot function pointers with __attribute__((regparm(n))),
# via a REGISTERS() macro in config.h guarded only by `#ifdef __GNUC__` —
# which in 1997 meant "x86", because GCC meant x86. regparm is an x86-32
# calling convention: x86-64 clang ignores it with a warning, and Apple
# Silicon clang rejects it outright ("'regparm' is not valid on this
# platform"), on the very first file it compiles. Confirmed directly on an
# arm64 Mac.
#
# Dropping the attribute is the whole fix — it's a micro-optimisation for
# passing arguments in registers on 32-bit x86, the macro is the only
# place it appears, and every declaration in the tree goes through that
# macro, so nothing ends up half-converted. The rest of the x86 code in
# here (minilzo.c's inline asm, ctrl87.c's x87 control word) is already
# `#ifdef __i386__`-guarded and compiles out on its own.
#
# The anchor is checked rather than assumed: if upstream ever rewrites
# that line, this says so and leaves the tree alone rather than silently
# doing nothing and letting the same arm64 error come back unexplained.
BB_REGPARM_ANCHOR='#define REGISTERS(n) __attribute__ ((regparm(n)))'
if grep -qF "$BB_REGPARM_ANCHOR" "$BB_SRC/config.h" 2>/dev/null; then
    # -i.bak, not -i '': the only form both BSD sed (macOS) and GNU sed take.
    sed -i.pi-bootstrap.bak \
        "s|$BB_REGPARM_ANCHOR|#define REGISTERS(n)  /* pi-bootstrap: regparm is x86-32 only */|" \
        "$BB_SRC/config.h"
    echo "   🔧 Patched out regparm (x86-32 only) for this platform."
elif grep -q "regparm" "$BB_SRC/config.h" 2>/dev/null; then
    echo "   ⚠️  config.h still mentions regparm but not in the form this script" >&2
    echo "      patches — the build will fail on Apple Silicon until that's" >&2
    echo "      looked at. See bin/install-bb's regparm comment." >&2
fi

# --with-libmikmod-prefix is the one flag the fork's own README calls out
# as sometimes needed; passing Homebrew's prefix unconditionally (when
# there is one) costs nothing and covers the case it describes.
CONFIGURE_ARGS=("--prefix=$BB_DIR" "--cache-file=/dev/null")
if command -v brew >/dev/null 2>&1; then
    BREW_PREFIX="$(brew --prefix 2>/dev/null)"
    [ -n "$BREW_PREFIX" ] && CONFIGURE_ARGS+=("--with-libmikmod-prefix=$BREW_PREFIX")
fi

# Clang 16 (Xcode 15) promoted a set of pre-ANSI C patterns from warnings
# to hard errors: implicit int, implicit function declarations, int
# conversions, incompatible function pointer types. All four are ordinary
# 1997 C, and bb is ordinary 1997 C.
#
# This bites before any of bb's own code is reached. autoconf 2.13's very
# first check compiles `main(){return(0);}` — implicit int — so configure
# concludes "C compiler cannot create executables" and stops, on a machine
# whose compiler is perfectly fine (confirmed directly: a real macOS run
# failed at exactly that check, having already found gcc). Turning the four
# back into warnings is what the fork's "builds on modern Macs" claim
# quietly assumed, back when clang still defaulted that way.
#
# Set on configure rather than make because the tree's Makefile.am is
# `CFLAGS=@CFLAGS@ -D SOUNDDIR=...` — whatever configure resolves is what
# the real compile uses, so one place covers both. The :- default preserves
# autoconf's own -g -O2 while letting a caller override it.
BB_CFLAGS="-Wno-implicit-int -Wno-implicit-function-declaration"
BB_CFLAGS="$BB_CFLAGS -Wno-int-conversion -Wno-incompatible-function-pointer-types"

{
    cd "$BB_SRC" || exit 1
    echo "=== configure ${CONFIGURE_ARGS[*]} ==="
    echo "=== CFLAGS: ${CFLAGS:--g -O2} $BB_CFLAGS ==="
    # LIBS=-lm: bb calls sqrt() and friends and never asks for libm, which
    # was fine in 1997 and is still fine on macOS (libSystem carries the
    # math functions, so the link resolves either way). glibc splits libm
    # out, so on Linux the link fails without this — confirmed directly,
    # and confirmed fixed by exactly this. Harmless on macOS, where -lm is
    # an empty stub kept for precisely this kind of portability.
    CFLAGS="${CFLAGS:--g -O2} $BB_CFLAGS" LIBS="${LIBS:-} -lm" \
        ./configure "${CONFIGURE_ARGS[@]}" &&
        echo "=== make ===" &&
        # `:` is /bin/true — these turn automake's own regeneration rules
        # into no-ops if the timestamp ordering above somehow still leaves
        # one live. Nothing here should ever need regenerating: the fork
        # ships every generated file already.
        make ACLOCAL=: AUTOCONF=: AUTOMAKE=: AUTOHEADER=: &&
        echo "=== make install ===" &&
        make ACLOCAL=: AUTOCONF=: AUTOMAKE=: AUTOHEADER=: install
} >> "$BB_LOG" 2>&1

if [ -x "$BB_DIR/bin/bb" ]; then
    echo "   ✅ Built bb — $BB_DIR/bin/bb"
    exit 0
fi

# The realistic failure: clang rejecting something autoconf 2.13 and
# 1997-era C got away with. Nothing to auto-repair, so record it and say
# where to look.
echo "   ⚠️  bb didn't build. Full output: $BB_LOG" >&2
echo "      Everything else still works; bb just shows as [not installed]" >&2
echo "      in whimsy-menu. Retry after fixing with: ~/bin/install-bb --force" >&2
touch "$BB_FAILED"
exit 1
