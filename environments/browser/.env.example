# Container name.
# Format: A valid Docker container name.
CONTAINER_NAME=browser

# Password for the VNC desktop you log into sites through. Leave empty and a
# random one is generated on first start and kept in the data volume — read it
# with: docker exec browser cat /data/vnc-password
# Format: Any string (macOS's built-in VNC client only uses the first 8 characters).
VNC_PASSWORD=

# Host port for VNC. Defaults to 5901, not 5900, because macOS Screen Sharing
# already owns 5900 when enabled.
# Format: A valid local TCP port.
VNC_PORT=5901

# Which host address VNC is published on. Loopback by default: reach it from
# another machine with an SSH tunnel (ssh -L 5901:localhost:5901 <host>), or
# set 0.0.0.0 to expose it on the LAN (password-protected, but VNC is
# unencrypted).
# Format: An IP address (127.0.0.1 or 0.0.0.0).
VNC_BIND=127.0.0.1

# Host port for the Chrome DevTools Protocol (CDP) — what agents connect to.
# Format: A valid local TCP port.
CDP_PORT=9222

# Which host address CDP is published on. CDP IS FULL, UNAUTHENTICATED CONTROL
# of the browser and everything logged in inside it.
#
# Default is 0.0.0.0 because agent containers must reach it, and on OrbStack
# host.docker.internal is not dependable for that (see nanoclaw-mnemon's
# MNEMON_EMBED_ENDPOINT note) — the working route is this host's LAN IP, which
# a loopback-only bind refuses. That also exposes it to your LAN. Narrow it:
#   - set this to this host's own LAN IP (not 0.0.0.0), and/or
#   - set CDP_ALLOW_RANGE below, and/or
#   - firewall the port to this host.
# Format: An IP address.
CDP_BIND=0.0.0.0

# Optional — only accept CDP connections from this source range, enforced
# inside the container by the relay. Leave empty for any. On Docker Desktop /
# OrbStack the source address a container sees may be a NAT address rather than
# the real client, so verify an agent can still connect after setting it.
# Format: CIDR, e.g. 192.168.1.0/24 (empty = any).
CDP_ALLOW_RANGE=

# Virtual display / window size.
# Format: WIDTHxHEIGHT.
SCREEN_SIZE=1440x900

# Optional — extra flags appended to the chromium command line (e.g. a proxy).
# Format: Space-separated chromium flags, or empty.
CHROMIUM_EXTRA_FLAGS=
