# Standalone OpenCode container reachable over SSH. Each interactive login
# attaches to a persistent tmux session running OpenCode in the mounted
# workspace.

CONTAINER_NAME=opencode
SSH_PORT=2225

# Host directory mounted at /home/opencode/workspace.
OPENCODE_WORKSPACE_PATH=~/opencode-workspace

# Public keys allowed to log in. One standard authorized_keys entry per line.
SSH_AUTHORIZED_KEYS_PATH=~/.ssh/authorized_keys

# Match these to the owner of OPENCODE_WORKSPACE_PATH on the TARGET host.
# Raspberry Pi OS commonly uses 1000/1000. macOS commonly uses 501/20;
# confirm on the Mac that will actually run the environment with `id -u`
# and `id -g`. The entrypoint safely handles macOS GID 20 even though a
# Debian group with that numeric ID already exists inside the image.
PUID=1000
PGID=1000

# Optional Git identity.
#GIT_USER_NAME=Your Name
#GIT_USER_EMAIL=you@example.com

# Optional GitHub token for gh and HTTPS git operations. SSH agent forwarding
# is an alternative and does not require this setting.
#
# Scope it to this environment — several coding CLIs working on different
# repos is the expected shape here, and one shared token means any of them
# can push to any of the others' projects.
#GH_TOKEN=

# --- Version pinning ---

# Which OpenCode release to build into the image. Empty means latest.
#
# ⚠️  PINNING MATTERS MORE HERE THAN ELSEWHERE. OpenCode's installer does NO
# checksum verification — it downloads the release archive and unpacks it.
# (herdr's and collie's installers both verify a sha256 sidecar and refuse to
# install without one.) A pin is what makes a build reproducible.
#
# Bumping this needs a CLEAN, not a FAST.
# Format: a release version like 1.0.180, or empty for latest.
#OPENCODE_VERSION=

# --- Credentials ---
#
# OpenCode's own `opencode auth login` stores credentials in
# ~/.local/share/opencode/auth.json inside a persistent volume, and is the
# better route for anything OAuth. These variables are the plain-API-key
# alternative; the entrypoint writes them into /etc/environment, which PAM
# loads into every SSH login.
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#GEMINI_API_KEY=
#OPENROUTER_API_KEY=

# --- Session defaults ---

# Passed to `opencode --model` when the base tmux session starts.
# Format: provider/model, e.g. anthropic/claude-sonnet-5.
#OPENCODE_MODEL=

# Passed to `opencode --agent`. See `opencode agent list`.
#OPENCODE_AGENT=

# ⚠️  Passes --auto, which approves every permission not explicitly denied.
#
# OpenCode's permission system is the main thing distinguishing it from pi's
# YOLO-by-default posture, and this turns it off. The container boundary and
# a scoped GH_TOKEN then become the only things doing that job.
# Format: 1 to auto-approve, unset otherwise.
#OPENCODE_AUTO_APPROVE=

# --- Routing through this repo's llm-gateways ---
#
# OpenCode redirects a provider with a `baseURL` in opencode.json rather than
# through an environment variable. Set this and the entrypoint writes that
# file — but ONLY IF IT DOES NOT ALREADY EXIST, since it is the file you edit
# by hand for agents, permissions, MCP servers and formatters.
#
# host.docker.internal, not localhost and not a container name: opencode and
# llm-gateways are separate Compose projects with no shared network, so the
# host is the only way through. Same reasoning as aider's README.
#
# Which provider gets redirected: openai, because LiteLLM speaks the OpenAI
# API. Models are then named openai/<model_name from litellm-config.yaml>.
#OPENCODE_GATEWAY_BASE_URL=http://host.docker.internal:4000/v1

# llm-gateways' own LITELLM_MASTER_KEY. Written into the container's
# OPENAI_API_KEY, because that is the provider whose baseURL was redirected.
# Kept as its own variable so pointing at the gateway does not mean
# overloading OPENAI_API_KEY, which means something else when it is not.
#OPENCODE_GATEWAY_API_KEY=
