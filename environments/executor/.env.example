# Executor — an MCP gateway. One endpoint fronting every integration, with
# credentials held server-side and per-tool allow / require-approval / block.
#
# Everything here is OPTIONAL. A bare deploy boots a working instance and
# walks you through creating the admin account in the browser.
#
# ⚠️  HOST THIS ON THE MAC, NOT THE PI. The moment Mac-hosted agents depend
# on it, the Pi stops being something you can switch off — and keeping the
# Pi removable is an explicit constraint of this whole design. See
# docs/future-enhancements/agent-control-environments.md, "The Pi must
# remain removable".

CONTAINER_NAME=executor
EXECUTOR_PORT=4788

# --- Image ---

# Upstream tags each release three ways: the release tag, the bare version,
# and a channel (`latest` for stable, `beta` for prereleases).
#
# NOTE THE NAMESPACE in docker-compose.yml: ghcr.io/usefulsoftwareco/ is
# current, and ghcr.io/rhyssullivan/ is the LEGACY name releases are still
# mirrored to. Both resolve today; only one is where new work lands.
# Format: a version like 1.2.3, or a channel: latest | beta.
#EXECUTOR_IMAGE_TAG=latest

# --- The URL browsers actually load ---

# ⚠️  THE SINGLE MOST COMMON WAY A WORKING INSTANCE LOOKS BROKEN. This must
# match scheme + host + port EXACTLY as you type it into the browser, or
# browser logins are rejected with nothing obviously wrong.
#
# Leave unset when you reach it at http://localhost:4788. Set it whenever
# there is a domain, TLS, or a non-default port in front.
#EXECUTOR_WEB_BASE_URL=https://executor.example.com

# Additional browser origins allowed to authenticate. Exact origins only,
# comma-separated. These do NOT change OAuth callbacks or generated links,
# which stay pinned to EXECUTOR_WEB_BASE_URL.
#EXECUTOR_TRUSTED_ORIGINS=http://executor.home.arpa:4788,http://192.0.2.10:4788

# --- Networking ---

# Host address the published port binds to. Defaults to all interfaces,
# matching llm-gateways — and deliberately, because the point of Executor is
# that OTHER CONTAINERS reach it, through host.docker.internal, which
# resolves to a host-gateway address rather than the host's loopback.
# Binding to 127.0.0.1 would make it unreachable from exactly the agents it
# exists to serve.
#
# What protects it is Executor's own gate: the first account created becomes
# owner and self-service signup then CLOSES.
# Format: an IP address.
#EXECUTOR_BIND_ADDRESS=0.0.0.0

# --- Session secret ---

# Generated and persisted under the data volume on first boot if unset. Set
# it to manage it yourself — minimum 32 characters. Rotating it signs every
# user out.
#BETTER_AUTH_SECRET=

# --- ⚠️  The two switches that widen what Executor can reach ---

# Lets sandboxed code reach loopback and private network addresses. OFF by
# default upstream, because adversarially generated code should not reach
# your internal network.
#
# Turning it on is not abstract here: this repo's ollama, llm-gateways,
# nanoclaw-mnemon and every agent container live on exactly that network.
# Format: true to allow, anything else to deny.
#EXECUTOR_ALLOW_LOCAL_NETWORK=true

# Lets users configure MCP servers whose commands EXECUTE ON THIS HOST.
# Disabled unless set to the exact string "true". Upstream labels it
# "trusted deployments only".
#
# Inside a container the blast radius is the container — but that container
# holds every credential you gave Executor.
#EXECUTOR_ALLOW_STDIO_MCP=true

# --- Organization ---
#EXECUTOR_ORG_NAME=Default
#EXECUTOR_ORG_SLUG=default

# --- Headless admin bootstrap ---
#
# Set BOTH to pre-create the admin instead of the in-browser first-run
# setup. Leave both unset for the browser flow, which is the recommended
# path for a single-operator deploy.
#EXECUTOR_BOOTSTRAP_ADMIN_EMAIL=you@example.com
#EXECUTOR_BOOTSTRAP_ADMIN_PASSWORD=
#EXECUTOR_BOOTSTRAP_ADMIN_NAME=Admin
