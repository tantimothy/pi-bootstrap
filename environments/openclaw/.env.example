# OpenClaw gateway with Claude CLI and Codex CLI in the same image.

# The long-running gateway container.
# Format: A single Docker container name.
CONTAINER_NAME=openclaw

# Host port for the OpenClaw Control UI and gateway WebSocket.
# Format: A valid local TCP port.
OPENCLAW_GATEWAY_PORT=18789

# Host port for OpenClaw's bridge service.
# Format: A valid local TCP port.
OPENCLAW_BRIDGE_PORT=18790

# Host port used by the optional Microsoft Teams channel.
# Format: A valid local TCP port.
OPENCLAW_MSTEAMS_PORT=3978

# The gateway must listen beyond loopback inside its container so the
# published Docker port can reach it. Authentication remains required.
# Format: lan or loopback. Use lan for this Docker deployment.
OPENCLAW_GATEWAY_BIND=lan

# IANA timezone used by the gateway and CLI containers.
# Format: An IANA timezone such as UTC, Asia/Singapore, or Europe/London.
OPENCLAW_TZ=UTC

# Authentication token for the Control UI and gateway clients. Leave this
# empty on first deploy and pre-deploy.sh generates a random 256-bit token,
# writes it back to .env, and preserves it on later FAST/CLEAN runs.
# Format: A long random token, or empty to generate one.
OPENCLAW_GATEWAY_TOKEN=

# Local tag for this environment's OpenClaw image with both CLIs installed.
# Change this only when running multiple independently-built instances.
# Format: A valid local Docker image tag.
OPENCLAW_LOCAL_IMAGE=openclaw-with-clis:latest
