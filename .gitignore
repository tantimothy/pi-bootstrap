.DS_Store

# Marker files run.sh touches to record that an environment has been launched
environments/*/.deployed

# Config fingerprint used by dragonos-sdr/kali-pentest to detect drift
# between an existing container and the current run.sh settings
environments/*/.container-config-hash

# Generated by info.sh's "list" action — always freshly regenerated, never
# something to track in git
environments/*/post-deploy-info.html

# Full session recordings of every FAST/STOP/TEARDOWN/CLEAN/INFO/WIPE run —
# see _run_logged in lib/deploy-lib.sh. Local troubleshooting artifacts,
# not something to track in git (and .env values a run echoes back could
# end up in here).
environments/*/logs/

# claude-cli's ~/.claude.json bind-mount source (see pre-deploy.sh) — a
# real, live file once deployed, holding actual MCP server registrations/
# onboarding state. pre-deploy.sh creates the placeholder itself if this
# is missing, so a fresh clone never needs it tracked, and tracking it
# would risk committing whatever real data ends up here after first use.
environments/claude-cli/data/

# openclaw's generated gateway token and Claude CLI's live single-file
# settings bind mount. Both are created locally during deployment and can
# contain credentials or MCP registrations.
environments/openclaw/.env
environments/openclaw/data/
